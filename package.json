{
  "name": "gcbuild",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "Click-to-build config generator for gcsim with KQMS substats and a rotation timeline helper",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "extract": "python -I scripts/extract_gcsim.py ../gcsim src/data/gcsim.json",
    "smoke": "tsx scripts/smoke.ts",
    "import-check": "tsx scripts/import-check.ts",
    "i18n-check": "tsx scripts/i18n-check.ts",
    "setup:gcsim": "node scripts/setup-gcsim.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "app": "vite build && node scripts/build-electron.mjs && node scripts/run-electron.mjs",
    "dist:win": "vite build && node scripts/build-electron.mjs && electron-builder --win --publish never",
    "release:win": "vite build && node scripts/build-electron.mjs && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "io.github.mirfeed.gcbuild",
    "productName": "gcBuild",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "gcBuild",
      "artifactName": "gcBuild-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mirfeed",
        "repo": "gcBuild",
        "releaseType": "draft"
      }
    ]
  }
}
